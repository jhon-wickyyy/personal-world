{
  "name": "personal-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal World  -  a Monument-Valley-inspired isometric personal website.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node tools/shots.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
